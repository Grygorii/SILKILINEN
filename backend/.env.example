# SILKILINEN backend — environment variables.
# Copy to `.env` and fill in. Never commit real secrets.

# ── Core (required; server refuses to boot without these) ──
MONGODB_URI=mongodb+srv://user:pass@cluster/silkilinen
JWT_SECRET=                      # ≥32 chars — admin sessions
JWT_CUSTOMER_SECRET=             # customer sessions
PREVIEW_TOKEN_SECRET=            # signs preview links (don't reuse JWT_SECRET)

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="SILKILINEN <orders@silkilinen.com>"
ADMIN_EMAIL=hello@silkilinen.com   # order notifications + weekly advisor digest

# ── URLs / CORS ──
CORS_ORIGINS=https://www.silkilinen.com,https://silkilinen.com
FRONTEND_URL=https://www.silkilinen.com
BACKEND_URL=https://api.silkilinen.com
BACKEND_PUBLIC_URL=https://api.silkilinen.com
PUBLIC_SITE_URL=https://www.silkilinen.com
SITE_URL=https://www.silkilinen.com
ADMIN_URL=https://www.silkilinen.com/admin

# ── Customer Google sign-in ──
GOOGLE_CLIENT_ID=

# ── Google APIs: Merchant Center (service account) + Search Console (OAuth) ──
GOOGLE_SERVICE_ACCOUNT_KEY=      # full JSON of the service-account key
MERCHANT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GSC_SITE_URL=sc-domain:silkilinen.com

# IndexNow instant-indexing key (optional). Must match the token served at
# https://www.silkilinen.com/<key>.txt (frontend/public/<key>.txt). Defaults to
# the committed key, so it works with no config; override to rotate the key.
INDEXNOW_KEY=

# ── AI (optional) ──
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DAILY_LIMIT=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_SEO=
FAL_KEY=
FASHN_API_KEY=
FASHN_BASE_URL=
FASHN_MODE=
FASHN_MODEL=

# ── Marketing / integrations (optional) ──
INSTAGRAM_ACCESS_TOKEN=
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
# Pinterest Conversions API (server-side checkout events). Ad account id defaults
# to 549770507607; token is generated in Pinterest → Conversions → Access token.
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_CONVERSION_TOKEN=

# ── Misc ──
LOG_LEVEL=info
PORT=3000

# Atelier screenshots: defaults to free WordPress mShots (no key). Override with a
# paid provider template using {url} and {w} placeholders for higher reliability.
SCREENSHOT_URL_TEMPLATE=
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Vercel Web Analytics (read-only) ──
# Lets the admin and the advisor read the traffic the storefront's <Analytics/>
# already reports, instead of it living only in Vercel's dashboard. Inert until
# the token and project are set: services/vercelAnalytics.js returns
# {configured:false} and every caller skips cleanly.
# Token: Vercel → Account Settings → Tokens (scope it to the team, read is enough).
# NOTE: Web Analytics must also be ENABLED for the project (Vercel → the project
# → Analytics). Until it is, the API returns 404 "Web Analytics not found" and
# the reader reports "never enabled" rather than pretending traffic is zero.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=prj_pSAUlq7bmoqY6Yto0L0VuOtvJFVj
VERCEL_TEAM_ID=team_4cJXkzKEo9oaVdKxuPHhzAzT

# ── Live SERP (Google Custom Search JSON API) ──
# Lets Hermes see the actual search results for a query, so he can judge whether
# a meta rewrite can realistically win it or whether the page is out-gunned and
# needs real content. Free for 100 queries/day. Inert without both values:
# services/seoIntel.js returns {configured:false} and the Site Audit skips it.
#
# GOOGLE_CSE_KEY — an API key from Google Cloud → APIs & Services → Credentials,
#   in the SAME project where the Custom Search JSON API is enabled. A key from
#   another project returns 403 "does not have the access" even when the API is
#   enabled somewhere else. If the key is restricted, allow Custom Search JSON
#   API; do NOT use an HTTP-referrer restriction — these are server-to-server
#   calls from Railway and have no referrer, so referrer restrictions 403 them.
# GOOGLE_CSE_ID — the search engine id (the "cx" value) from
#   https://programmablesearchengine.google.com — NOT the API key.
#   ⚠️ The engine must SEARCH THE ENTIRE WEB. The one currently in the console is
#   a curated ~40-site set (silkilinen.com + competitors: La Perla, Eberjey,
#   Lunya, Olivia von Halle…). That is a genuinely useful asset, but it is not a
#   Google results page: it can never surface the Wikipedia entry, the magazine
#   guide or the marketplace listing that actually holds page one — and judging
#   "can a title rewrite win this query" against a competitor-only list is how
#   Hermes concludes a fight is winnable when it is not. Keep the curated engine,
#   create a second one set to the whole web, and point this variable at that.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
